{
  "name": "@typegaro/atom-plugin",
  "version": "0.0.1",
  "description": "SDK for building Atom plugins",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "constants.d.ts",
    "index.d.ts",
    "index.js",
    "sdk-types.d.ts",
    "style.d.ts",
    "types.d.ts",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.12"
  },
  "dependencies": {
    "@typegaro/atom-types": "workspace:*",
    "commander": "^14.0.1"
  },
  "types": "./index.d.ts",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun && tsc -p ./tsconfig.build.json && node ../../scripts/prepare-npm-package.mjs packages/atom-plugin",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  }
}
